# Environment Variables Template
# Copy this file to .env and fill in your actual API credentials.
# NEVER commit the actual .env file with secret keys to version control.

# Google Gemini API key (Required for Intake multilingual NLP & Decision synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Database & Storage
SQLITE_DB_PATH=data/tb_screening.db

# Environment mode: development / testing / production
ENV=development
